# Secret for POST /api/crawl (manual run / backfill)
CRAWL_SECRET=change-me
# Timezone whose "today" decides which daily puzzle to crawl
PUZZLE_TIMEZONE=Asia/Kolkata
SITE_TITLE=Daily Sudoku Results
# Timezone whose "today" decides which Wordle answer to publish
WORDLE_TIMEZONE=Asia/Kolkata
# Timezone whose "today" decides which Connections puzzle to publish
CONNECTIONS_TIMEZONE=Asia/Kolkata
# Timezone whose "today" decides which Spelling Bee puzzle to publish
SPELLING_BEE_TIMEZONE=Asia/Kolkata
# Timezone whose "today" decides which Queens puzzle to publish
QUEENS_TIMEZONE=Asia/Kolkata
# Timezone whose "today" decides which Tango puzzle to publish
TANGO_TIMEZONE=Asia/Kolkata
# Timezone whose "today" decides which Zip puzzle to publish
ZIP_TIMEZONE=Asia/Kolkata
STRANDS_TIMEZONE=Asia/Kolkata
MINI_CROSSWORD_TIMEZONE=Asia/Kolkata
# LinkedIn rolls its games over at midnight Pacific; this decides which date each LinkedIn puzzle is saved under
LINKEDIN_TIMEZONE=America/Los_Angeles
# Slack Incoming Webhook URL; failed daily crawls post a message there (leave empty to disable)
SLACK_WEBHOOK_URL=
# Days of results kept in the blob stores; older days are deleted daily
RETENTION_DAYS=30
